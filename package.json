{
  "name": "localnodeai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "esbuild tests/logic.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/logic.test.mjs --log-level=warning && node node_modules/.tmp/logic.test.mjs && npm run test:menu",
    "test:menu": "esbuild tests/contextmenu.test.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.tmp/contextmenu.test.cjs --log-level=warning && node node_modules/.tmp/contextmenu.test.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.85",
    "@xyflow/react": "^12.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
